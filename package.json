{
  "name": "stq-education-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "qa:structural": "tsx scripts/qa-visual-structural.ts",
    "qa:visual": "tsx scripts/capture-post-merge-qa.ts",
    "postinstall": "prisma generate",
    "test": "dotenv -e .env.test -v NODE_ENV=test -v IS_TEST_RUN=true -v ALLOW_ISOLATED_TEST_DB=true -v TEST_DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5433/stq_test?schema=test_portal -- tsx --conditions=react-server --test --test-concurrency=1 tests/*.test.ts",
    "db:backup": "tsx scripts/backup-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
